# Rust build artefacts.
/target/
# rustfmt backups.
**/*.rs.bk
# MSVC debugger symbols (Windows builds, incl. CI) — from the canonical
# github/gitignore Rust template.
*.pdb

# Cargo.lock is intentionally NOT ignored: ynotes ships a binary, so the
# lockfile is part of the reproducible deliverable and is committed. A library
# would ignore it (see the GitHub Rust .gitignore template).

# insta snapshot tests: pending/rejected snapshots are never committed; they
# are reviewed and accepted with `cargo insta`.
*.pending-snap
*.snap.new

# `cargo build --timings` reports.
cargo-timing*.html
# ctags output.
tags

# Local reference cache — NOT for version control. `.opensrc/` holds large
# upstream clones AND the curated RUST_REFERENCES.md; all of it is local-only
# and regenerable via `opensrc fetch`. Ignore the whole tree, no exceptions.
/.opensrc/

# Editors & OS noise. (gitoxide argues these belong in a global
# core.excludesFile; ripgrep/jj/bat list them directly — following the majority.)
.idea/
.vscode/
.zed/
*.swp
*.swo
.DS_Store
Thumbs.db
